# The server's settings. On the server: cp deploy/server.env.example .env && nano .env
# This file stays on the server only. Never commit it, never paste it into a chat.

# Your domain, without https://
DOMAIN=example.xyz
# The same with https://, for links to verdict card images
SITE_URL=https://example.xyz

# Password of the server's own database. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Coin address. Empty before launch: the site runs in demo mode
TOKEN_MINT=
# The Altar's public address (npm run altar:new on your computer). Never its private key
ALTAR_WALLET=

# Helius RPC with your key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Any long random string. Make one with: openssl rand -hex 32
INDEXER_SECRET=
# Seconds between indexer passes
INDEXER_EVERY_SECONDS=180

# The coin's X account
NEXT_PUBLIC_X_URL=

# Optional: prophecies written by a model
PROPHECY_API_KEY=
PROPHECY_MODEL=
