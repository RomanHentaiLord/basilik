# Copy to .env.local and fill in. Never commit .env.local.

# Mint address of the coin. Leave empty before launch: the site runs in demo mode
# and invents a stable history for any wallet so the design can be tested.
TOKEN_MINT=

# Any Solana RPC. The Helius free plan (1M credits/month) is enough to start.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Neon Postgres. Check it with: npm run db:check. Create the tables with: npm run db:migrate
DATABASE_URL=

# The coin's X account, for the button in the header. Empty: the button waits for launch.
NEXT_PUBLIC_X_URL=

# Secret for GET /api/indexer (the sales scanner). Any long random string.
# Put the same value into the GitHub repository secrets as INDEXER_SECRET.
INDEXER_SECRET=

# Creator-fee wallet ("the Altar"), public address only: npm run altar:new prints it.
# Excluded from both Books. Never put its private key here or anywhere in the project.
ALTAR_WALLET=
# Only if the Altar's key file is not where npm run altar:new saved it (~/.basilisk/altar.json).
# Local only, never on Vercel.
# ALTAR_KEYPAIR=

# The site's address, for links to verdict card images. On Vercel it can stay empty.
SITE_URL=

# Optional: a language model writes the prophecies. Empty: hand-written phrases.
# Any OpenAI-compatible API. For OpenRouter: PROPHECY_API_URL=https://openrouter.ai/api/v1
PROPHECY_API_KEY=
PROPHECY_MODEL=
# PROPHECY_API_URL=https://api.openai.com/v1
# PROPHECY_MODEL_LARGE=

# Testing only: force a market state for the seals.
# MARKET_MCAP_USD=12000
# MARKET_CURVE_PERCENT=47
# MARKET_GRADUATED=false
